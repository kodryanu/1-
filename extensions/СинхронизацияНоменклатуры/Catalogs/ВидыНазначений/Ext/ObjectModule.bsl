// Расширение модуля объекта справочника "Виды назначений".
//
// При записи вида назначения актуализирует связанную с ним номенклатуру
// (служебный реквизит "Номенклатура", закрытый для редактирования пользователями):
// - Наименование и НаименованиеПолное берутся из одноимённых реквизитов вида
//   назначения; Категория - из реквизита "КатегорияПоУмолчанию".
// - Если "КатегорияПоУмолчанию" не заполнена - номенклатура не создаётся и не
//   изменяется (запись вида назначения при этом проходит как обычно).
// - Если номенклатура уже создана, но её текущая категория (могли изменить как
//   в самой номенклатуре, так и в виде назначения) не совпадает с
//   "КатегорияПоУмолчанию" - запись вида назначения блокируется (Отказ = Истина)
//   с предупреждением пользователю: рассинхронизацию нужно устранить руками.
// - При создании новой номенклатуры группа (папка) берётся из константы
//   "Озон_ГруппаНоменклатурыМедицинскиеУслуги"; если константа не заполнена -
//   запись вида назначения блокируется с предупреждением.
// - Номенклатура записывается в привилегированном режиме (реквизит служебный,
//   обычным пользователям запись справочника "Номенклатура" может быть закрыта).
// - Если ключевые реквизиты (Наименование, НаименованиеПолное, Категория) у уже
//   созданной номенклатуры не отличаются от требуемых значений - повторная
//   запись номенклатуры не выполняется.

&Перед("ПередЗаписью")
Процедура Озон_ПередЗаписью(Отказ)

	Озон_АктуализироватьНоменклатуру(Отказ);

КонецПроцедуры

Процедура Озон_АктуализироватьНоменклатуру(Отказ)

	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	// Категория по умолчанию не задана - интеграция с номенклатурой не ведётся:
	// ни создание, ни проверка рассинхронизации не выполняются.
	Если Не ЗначениеЗаполнено(КатегорияПоУмолчанию) Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(Номенклатура) Тогда
		Озон_АктуализироватьСуществующуюНоменклатуру(Отказ);
	Иначе
		Озон_СоздатьНоменклатуру(Отказ);
	КонецЕсли;

КонецПроцедуры

Процедура Озон_АктуализироватьСуществующуюНоменклатуру(Отказ)

	УстановитьПривилегированныйРежим(Истина);
	НоменклатураОбъект = Номенклатура.ПолучитьОбъект();
	УстановитьПривилегированныйРежим(Ложь);

	Если НоменклатураОбъект.Категория <> КатегорияПоУмолчанию Тогда

		ОбщегоНазначения.СообщитьПользователю(
			СтрШаблон(
				НСтр("ru = 'Категория связанной номенклатуры (%1) не совпадает с категорией
				|по умолчанию вида назначения ""%2"" (%3). Приведите категории в
				|соответствие - в номенклатуре ""%4"" или в виде назначения - и повторите запись.'"),
				Строка(НоменклатураОбъект.Категория), Наименование, Строка(КатегорияПоУмолчанию),
				НоменклатураОбъект.Наименование),
			, "КатегорияПоУмолчанию", , Отказ);

		Возврат;

	КонецЕсли;

	Если НоменклатураОбъект.Наименование = Наименование
		И НоменклатураОбъект.НаименованиеПолное = НаименованиеПолное Тогда
		// Ключевые реквизиты не изменились - перезапись номенклатуры не требуется.
		Возврат;
	КонецЕсли;

	НоменклатураОбъект.Наименование = Наименование;
	НоменклатураОбъект.НаименованиеПолное = НаименованиеПолное;

	Озон_ЗаписатьНоменклатуруВПривилегированномРежиме(НоменклатураОбъект);

КонецПроцедуры

Процедура Озон_СоздатьНоменклатуру(Отказ)

	ГруппаНоменклатуры = Константы.Озон_ГруппаНоменклатурыМедицинскиеУслуги.Получить();

	Если Не ЗначениеЗаполнено(ГруппаНоменклатуры) Тогда

		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Не задана группа номенклатуры в константе
			|""Озон_ГруппаНоменклатурыМедицинскиеУслуги"". Обратитесь к администратору.'"),
			, , , Отказ);

		Возврат;

	КонецЕсли;

	НоваяНоменклатура = Справочники.Номенклатура.СоздатьЭлемент();
	НоваяНоменклатура.Наименование = Наименование;
	НоваяНоменклатура.НаименованиеПолное = НаименованиеПолное;
	НоваяНоменклатура.Категория = КатегорияПоУмолчанию;
	НоваяНоменклатура.Родитель = ГруппаНоменклатуры;

	Озон_ЗаписатьНоменклатуруВПривилегированномРежиме(НоваяНоменклатура);

	Номенклатура = НоваяНоменклатура.Ссылка;

КонецПроцедуры

Процедура Озон_ЗаписатьНоменклатуруВПривилегированномРежиме(Знач НоменклатураОбъект)

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		НоменклатураОбъект.Записать();
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры
