// Клиентский общий модуль расширения "Этапы производства": режим терминала (киоска).
// Свойства модуля: Клиент (управляемое приложение) = Истина, остальные флаги выключены.

#Область ПрограммныйИнтерфейс

// Если пользователю назначена роль Орто_Терминал - включает режим терминала и переводит
// основное окно в режим киоска (на весь экран, без заголовка, главного меню, панели
// разделов и панели открытых).
// Признак роли вычисляется на сервере и приходит вместе с параметрами работы клиента
// при запуске - дополнительного серверного вызова нет.
// Вызывается из ОбщегоНазначенияКлиентПереопределяемый.ПередНачаломРаботыСистемы.
//
Процедура ПередНачаломРаботыСистемы() Экспорт

	ПараметрыКлиента = СтандартныеПодсистемыКлиент.ПараметрыРаботыКлиентаПриЗапуске();
	Если ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыКлиента, "Орто_РежимТерминала", Ложь) <> Истина Тогда
		Возврат;
	КонецЕсли;

	// Состояние режима терминала хранится на весь сеанс: его используют
	// ПослеНачалаРаботыСистемы и форма терминала при закрытии.
	СостояниеТерминала = Новый Структура("РежимКиоска", Ложь);
	ПараметрыПриложения.Вставить(ИмяПараметраРежимТерминала(), СостояниеТерминала);

	// Платформа позволяет установить режим основного окна только синхронно внутри
	// обработчика ПередНачаломРаботыСистемы. Если ранее при запуске понадобились
	// интерактивные действия (обновление ИБ, смена пароля и т.п.), БСП продолжает
	// запуск уже вне этого обработчика и платформа вызывает исключение. Проверить
	// это заранее нельзя, поэтому используется Попытка: при неудаче форма терминала
	// откроется с блокировкой всего интерфейса (см. ОткрытьФормуТерминала),
	// а режим киоска включится при следующем входе.
	Попытка
		КлиентскоеПриложение.УстановитьРежимОсновногоОкна(РежимОсновногоОкнаКлиентскогоПриложения.Киоск);
		СостояниеТерминала.РежимКиоска = Истина;
	Исключение
		ЖурналРегистрацииКлиент.ДобавитьСообщениеДляЖурналаРегистрации(
			НСтр("ru = 'Режим терминала'", ОбщегоНазначенияКлиент.КодОсновногоЯзыка()),
			"Предупреждение",
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Открывает форму терминала, если включён режим терминала.
// Вызывается из ОбщегоНазначенияКлиентПереопределяемый.ПослеНачалаРаботыСистемы:
// к этому моменту стандартные проверки при входе уже завершены.
//
Процедура ПослеНачалаРаботыСистемы() Экспорт

	Если РежимТерминалаВключен() Тогда
		ОткрытьФормуТерминала();
	КонецЕсли;

КонецПроцедуры

// Возвращаемое значение:
//  Булево - Истина, если текущий сеанс работает в режиме терминала.
//
Функция РежимТерминалаВключен() Экспорт

	Возврат ПараметрыПриложения.Получить(ИмяПараметраРежимТерминала()) <> Неопределено;

КонецФункции

// Открывает форму терминала (если форма уже открыта - активирует её, повторно не открывает).
// В режиме киоска форма открывается в основном окне на весь экран; если режим киоска
// включить не удалось - с блокировкой всего интерфейса, чтобы остальные разделы
// программы были недоступны.
//
Процедура ОткрытьФормуТерминала() Экспорт

	ИмяФормы = "Обработка.Орто_Терминал.Форма.ФормаТерминала";
	СостояниеТерминала = ПараметрыПриложения.Получить(ИмяПараметраРежимТерминала());

	Если СостояниеТерминала <> Неопределено И СостояниеТерминала.РежимКиоска Тогда
		ОткрытьФорму(ИмяФормы, , , ИмяФормы, ОсновноеОкноПриложения());
	Иначе
		ОткрытьФорму(ИмяФормы, , , ИмяФормы, , , , РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИмяПараметраРежимТерминала()

	Возврат "Орто.РежимТерминала";

КонецФункции

Функция ОсновноеОкноПриложения()

	Для Каждого Окно Из ПолучитьОкна() Цикл
		Если Окно.Основное Тогда
			Возврат Окно;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

#КонецОбласти
