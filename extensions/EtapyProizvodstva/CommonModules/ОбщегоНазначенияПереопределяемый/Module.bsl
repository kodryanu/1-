// Расширение общего модуля ОбщегоНазначенияПереопределяемый (БСП).
// Модуль заимствуется в расширение "ЭтапыПроизводства", код добавляется в его модуль.

// Признак режима терминала передаётся на клиент в составе параметров работы клиента
// при запуске: они получаются одним серверным вызовом и кэшируются на клиенте,
// поэтому отдельный вызов сервера для проверки роли не нужен.
&После("ПриДобавленииПараметровРаботыКлиентаПриЗапуске")
Процедура Орто_ПриДобавленииПараметровРаботыКлиентаПриЗапуске(Параметры)

	Параметры.Вставить("Орто_РежимТерминала", Орто_ЭтоПользовательТерминала());

КонецПроцедуры

// Возвращаемое значение:
//  Булево - Истина, если текущему пользователю назначена роль Орто_Терминал.
//
Функция Орто_ЭтоПользовательТерминала()

	РольТерминала = Метаданные.Роли.Орто_Терминал;

	// В привилегированном режиме РольДоступна() возвращает Истина для любой роли,
	// поэтому в нём проверяется фактический состав ролей пользователя ИБ.
	Если ПривилегированныйРежим() Тогда
		Возврат ПользователиИнформационнойБазы.ТекущийПользователь().Роли.Содержит(РольТерминала);
	КонецЕсли;

	Возврат РольДоступна(РольТерминала);

КонецФункции
