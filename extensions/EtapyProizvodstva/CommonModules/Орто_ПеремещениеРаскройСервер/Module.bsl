// Серверный общий модуль расширения "Этапы производства".
// Свойства модуля: Сервер = Истина, ВызовСервера = Истина, остальные флаги (Клиент) выключены.

// Готовит структуру ЗначенияЗаполнения для создания документа "Перемещение запасов"
// на основании нескольких заказов на производство: в табличную часть Запасы
// попадают только материалы с этапом "Раскрой деталей", материалы свёрнуты
// по Номенклатура+Характеристика+Партия+ЕдиницаИзмерения с суммированием Количество.
//
// Параметры:
//  МассивЗаказов - Массив из ДокументСсылка.ЗаказНаПроизводство - выделенные пользователем заказы
//  ТекстОшибки   - Строка - возвращается непустой строкой, если заполнение невозможно
//
// Возвращаемое значение:
//  Структура, Неопределено - значения для открытия формы документа ПеремещениеЗапасов
//                             (Неопределено, если заполнение невозможно - см. ТекстОшибки)
//
Функция ПодготовитьЗначенияЗаполнения(Знач МассивЗаказов, ТекстОшибки) Экспорт

	ТекстОшибки = "";

	Если МассивЗаказов = Неопределено Или МассивЗаказов.Количество() = 0 Тогда
		ТекстОшибки = НСтр("ru = 'Не выбрано ни одного заказа на производство.'");
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивЗаказов", МассивЗаказов);
	Запрос.УстановитьПараметр("НаименованиеЭтапа", "Раскрой деталей");
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Заказы.Ссылка КАК Заказ,
	|	Заказы.Номер КАК Номер,
	|	Заказы.ЗаказПокупателя КАК ЗаказПокупателя
	|ИЗ
	|	Документ.ЗаказНаПроизводство КАК Заказы
	|ГДЕ
	|	Заказы.Ссылка В (&МассивЗаказов)
	|;
	|
	|ВЫБРАТЬ
	|	Запасы.Номенклатура КАК Номенклатура,
	|	Запасы.Характеристика КАК Характеристика,
	|	Запасы.Партия КАК Партия,
	|	Запасы.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	Запасы.Количество КАК Количество
	|ИЗ
	|	Документ.ЗаказНаПроизводство.Запасы КАК Запасы
	|ГДЕ
	|	Запасы.Ссылка В (&МассивЗаказов)
	|	И Запасы.Этап.Наименование = &НаименованиеЭтапа";

	РезультатыПакета = Запрос.ВыполнитьПакет();
	ВыборкаЗаказы    = РезультатыПакета[0].Выбрать();
	ВыборкаМатериалы = РезультатыПакета[1].Выбрать();

	МассивНомеров = Новый Массив;
	ОбщийЗаказПокупателя = Неопределено;
	ПервыйЗаказОбработан = Ложь;
	ЕстьРазныеЗаказыПокупателей = Ложь;

	Пока ВыборкаЗаказы.Следующий() Цикл
		МассивНомеров.Добавить(ВыборкаЗаказы.Номер);
		Если Не ПервыйЗаказОбработан Тогда
			ОбщийЗаказПокупателя = ВыборкаЗаказы.ЗаказПокупателя;
			ПервыйЗаказОбработан = Истина;
		ИначеЕсли ОбщийЗаказПокупателя <> ВыборкаЗаказы.ЗаказПокупателя Тогда
			ЕстьРазныеЗаказыПокупателей = Истина;
		КонецЕсли;
	КонецЦикла;

	Если ЕстьРазныеЗаказыПокупателей Или Не ЗначениеЗаполнено(ОбщийЗаказПокупателя) Тогда
		ОбщийЗаказПокупателя = Неопределено;
	КонецЕсли;

	ТаблицаЗапасов = Новый ТаблицаЗначений;
	ТаблицаЗапасов.Колонки.Добавить("Номенклатура");
	ТаблицаЗапасов.Колонки.Добавить("Характеристика");
	ТаблицаЗапасов.Колонки.Добавить("Партия");
	ТаблицаЗапасов.Колонки.Добавить("ЕдиницаИзмерения");
	ТаблицаЗапасов.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));

	Пока ВыборкаМатериалы.Следующий() Цикл
		НоваяСтрока = ТаблицаЗапасов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаМатериалы);
	КонецЦикла;

	Если ТаблицаЗапасов.Количество() = 0 Тогда
		ТекстОшибки = НСтр("ru = 'В выбранных заказах на производство нет материалов с этапом ""Раскрой деталей"".'");
		Возврат Неопределено;
	КонецЕсли;

	ТаблицаЗапасов.Свернуть("Номенклатура, Характеристика, Партия, ЕдиницаИзмерения", "Количество");

	МассивСтрокЗапасов = Новый Массив;
	Для Каждого СтрокаТЗ Из ТаблицаЗапасов Цикл
		СтрокаЗначений = Новый Структура("Номенклатура, Характеристика, Партия, ЕдиницаИзмерения, Количество");
		ЗаполнитьЗначенияСвойств(СтрокаЗначений, СтрокаТЗ);
		МассивСтрокЗапасов.Добавить(СтрокаЗначений);
	КонецЦикла;

	ЗначенияЗаполнения = Новый Структура;
	ЗначенияЗаполнения.Вставить("Комментарий", СтрСоединить(МассивНомеров, ", "));
	ЗначенияЗаполнения.Вставить("Запасы", МассивСтрокЗапасов);
	Если ОбщийЗаказПокупателя <> Неопределено Тогда
		ЗначенияЗаполнения.Вставить("ДокументОснование", ОбщийЗаказПокупателя);
	КонецЕсли;

	Возврат ЗначенияЗаполнения;

КонецФункции
