// Серверный общий модуль расширения "Этапы производства".
// Свойства модуля: Сервер = Истина, ВызовСервера = Ложь, Клиент (управляемое и обычное
// приложение) = Ложь, Внешнее соединение = Ложь, Привилегированный режим = Истина
// (регламентное задание выполняется без сеанса пользователя и не должно зависеть
// от прав конкретного пользователя или ограничений RLS на справочник "Договоры"),
// Повторное использование возвращаемых значений = Не использовать.
//
// Обработчик регламентного задания "Орто_АрхивированиеПросроченныхДоговоров".

// Помечает признаком "Недействителен" договоры (Справочник.Договоры), у которых
// заполнен реквизит "СрокДействия" и этот срок уже истёк (дата меньше начала
// текущего дня). Договоры с пустым "СрокДействия" считаются бессрочными,
// с автоматической пролонгацией, и просроченными не считаются - такие договоры
// процедура не изменяет. Уже помеченные как "Недействителен" и помеченные на
// удаление договоры повторно не обрабатываются.
//
Процедура ПометитьПросроченныеДоговорыНедействительными() Экспорт

	ГраницаДействия = НачалоДня(ТекущаяДата());

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ГраницаДействия", ГраницаДействия);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Договоры.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Договоры КАК Договоры
	|ГДЕ
	|	НЕ Договоры.ЭтоГруппа
	|	И НЕ Договоры.ПометкаУдаления
	|	И НЕ Договоры.Недействителен
	|	И Договоры.СрокДействия <> ДАТАВРЕМЯ(1, 1, 1)
	|	И Договоры.СрокДействия < &ГраницаДействия";

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		Попытка
			ОбъектДоговора = Выборка.Ссылка.ПолучитьОбъект();
			Если ОбъектДоговора = Неопределено Тогда
				// Договор удалён параллельно - пропускаем.
				Продолжить;
			КонецЕсли;
			ОбъектДоговора.Недействителен = Истина;
			ОбъектДоговора.Записать();
		Исключение
			ЗаписьЖурналаРегистрации(
				НСтр("ru = 'Архивирование просроченных договоров'"),
				УровеньЖурналаРегистрации.Ошибка,
				,
				Выборка.Ссылка,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;

	КонецЦикла;

КонецПроцедуры
