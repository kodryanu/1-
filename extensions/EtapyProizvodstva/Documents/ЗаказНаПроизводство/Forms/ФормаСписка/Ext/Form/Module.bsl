// Расширение формы списка "Заказ на производство".
// Кнопка "Перемещение (материалы для раскроя)" добавляется программно рядом
// с существующей кнопкой ЧастичныйВыпуск, а не через декларативные механизмы
// (Группа команды / БСП ПодключаемыеКоманды) - на этой форме они ненадёжны
// для новых добавленных расширением команд.

&После("ПриСозданииНаСервере")
Процедура Орто_ПослеПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Орто_ДобавитьКомандуПеремещениеРаскрой();

КонецПроцедуры

&НаСервере
Процедура Орто_ДобавитьКомандуПеремещениеРаскрой()

	ЭлементОснова = Элементы.Найти("ЧастичныйВыпуск");
	Если ЭлементОснова = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Команды.Найти("Орто_ПеремещениеРаскрой") = Неопределено Тогда
		НоваяКоманда = Команды.Добавить("Орто_ПеремещениеРаскрой");
		НоваяКоманда.Действие = "Орто_ПеремещениеРаскрой";
		НоваяКоманда.Заголовок = НСтр("ru = 'Перемещение (материалы для раскроя)'");
	КонецЕсли;

	Если Элементы.Найти("Орто_КнопкаПеремещениеРаскрой") = Неопределено Тогда
		НоваяКнопка = Элементы.Добавить("Орто_КнопкаПеремещениеРаскрой", Тип("КнопкаФормы"), ЭлементОснова.Родитель);
		НоваяКнопка.ИмяКоманды = "Орто_ПеремещениеРаскрой";
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Орто_ПеремещениеРаскрой(Команда)

	МассивЗаказов = Элементы.Список.ВыделенныеСтроки;

	Если ТипЗнч(МассивЗаказов) <> Тип("Массив") Или МассивЗаказов.Количество() = 0 Тогда
		ПоказатьПредупреждение(Неопределено, НСтр("ru = 'Выделите один или несколько заказов на производство.'"));
		Возврат;
	КонецЕсли;

	ТекстОшибки = "";
	ЗначенияЗаполнения = Орто_ПодготовитьЗначенияЗаполненияНаСервере(МассивЗаказов, ТекстОшибки);

	Если ЗначенияЗаполнения = Неопределено Тогда
		ПоказатьПредупреждение(Неопределено, ТекстОшибки);
		Возврат;
	КонецЕсли;

	ПараметрыОткрытия = Новый Структура("ЗначенияЗаполнения", ЗначенияЗаполнения);
	ОткрытьФорму("Документ.ПеремещениеЗапасов.ФормаОбъекта", ПараметрыОткрытия, ЭтотОбъект);

КонецПроцедуры

&НаСервере
Функция Орто_ПодготовитьЗначенияЗаполненияНаСервере(МассивЗаказов, ТекстОшибки)

	Возврат Орто_ПеремещениеРаскройСервер.ПодготовитьЗначенияЗаполнения(МассивЗаказов, ТекстОшибки);

КонецФункции
