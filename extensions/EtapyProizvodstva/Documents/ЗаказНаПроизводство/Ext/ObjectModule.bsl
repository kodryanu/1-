// Расширение модуля объекта документа "Заказ на производство".
//
// Проверяет, что в табличной части "Операции" для каждого этапа исполнитель
// указан одинаково во всех строках этого этапа. Пустой исполнитель считается
// отдельным значением наравне с заполненным - т.е. сочетание "исполнитель не
// указан" + "исполнитель указан" для одного этапа тоже считается расхождением.
// Проверка размещена в ОбработкаПроверкиЗаполнения (единая точка для всех
// проверок заполнения в конфигурации) - срабатывает и при интерактивной
// записи/проведении, и при программном вызове ПроверитьЗаполнение().
// Используется &Перед, а не &Вместо: базовая ОбработкаПроверкиЗаполнения по
// стандарту 1С проверяет Отказ в начале, поэтому такой контроль надёжно
// блокирует запись/проведение без дублирования штатной логики.

&Перед("ОбработкаПроверкиЗаполнения")
Процедура Орто_ПередОбработкойПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Орто_ПроверитьИсполнителейПоЭтапам(Отказ);

КонецПроцедуры

Процедура Орто_ПроверитьИсполнителейПоЭтапам(Отказ)

	ЭтапыИсполнители = Новый Соответствие; // Этап -> Массив различных Исполнитель, встреченных по этапу

	Для Каждого СтрокаОперации Из Операции Цикл

		Если Не ЗначениеЗаполнено(СтрокаОперации.Этап) Тогда
			Продолжить;
		КонецЕсли;

		МассивИсполнителей = ЭтапыИсполнители[СтрокаОперации.Этап];
		Если МассивИсполнителей = Неопределено Тогда
			МассивИсполнителей = Новый Массив;
			ЭтапыИсполнители.Вставить(СтрокаОперации.Этап, МассивИсполнителей);
		КонецЕсли;

		// Пустой исполнитель (ПустаяСсылка) тоже добавляется в массив - как
		// отдельное, "своё" значение, наравне с заполненными.
		Если МассивИсполнителей.Найти(СтрокаОперации.Исполнитель) = Неопределено Тогда
			МассивИсполнителей.Добавить(СтрокаОперации.Исполнитель);
		КонецЕсли;

	КонецЦикла;

	Для Каждого ЭлементЭтапа Из ЭтапыИсполнители Цикл

		Если ЭлементЭтапа.Значение.Количество() <= 1 Тогда
			Продолжить;
		КонецЕсли;

		ПредставленияИсполнителей = Новый Массив;
		Для Каждого Исполнитель Из ЭлементЭтапа.Значение Цикл
			Если ЗначениеЗаполнено(Исполнитель) Тогда
				ПредставленияИсполнителей.Добавить(Строка(Исполнитель));
			Иначе
				ПредставленияИсполнителей.Добавить(НСтр("ru = '<не указан>'"));
			КонецЕсли;
		КонецЦикла;

		ТекстСообщения = СтрШаблон(
			НСтр("ru = 'В табличной части ""Операции"" для этапа ""%1"" указаны разные исполнители: %2.
			|Для одного этапа исполнитель должен быть одинаковым во всех строках (в т.ч. везде заполнен или везде не указан).'"),
			Строка(ЭлементЭтапа.Ключ),
			СтрСоединить(ПредставленияИсполнителей, ", "));

		// Указываем на каждую строку этого этапа, чтобы пользователь видел все проблемные строки.
		// ДанныеОбъект не принимает строку табличной части (только ссылку), поэтому
		// строка/колонка адресуется через ПутьКДанным - путь по данным формы
		// документа (стандартное имя реквизита формы, хранящего объект, - "Объект").
		Для Каждого СтрокаОперации Из Операции Цикл
			Если СтрокаОперации.Этап = ЭлементЭтапа.Ключ Тогда
				НомерСтроки = Операции.Индекс(СтрокаОперации);
				ПутьКДанным = "Объект.Операции[" + НомерСтроки + "].Исполнитель";
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , , ПутьКДанным, Отказ);
			КонецЕсли;
		КонецЦикла;

	КонецЦикла;

КонецПроцедуры
