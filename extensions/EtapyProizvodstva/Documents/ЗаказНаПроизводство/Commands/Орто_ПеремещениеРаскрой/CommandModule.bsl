// Модуль команды "Перемещение (материалы для раскроя)".
// Свойства команды: Группа = КоманднаяПанельФормыСоздатьНаОсновании,
// ТипПараметраКоманды = ДокументСсылка.ЗаказНаПроизводство, РежимИспользованияПараметра = Множественный.

&НаКлиенте
Процедура ОбработкаКоманды(МассивЗаказов, ПараметрыВыполненияКоманды) Экспорт

	ТекстОшибки = "";
	ЗначенияЗаполнения = Орто_ПеремещениеРаскройСервер.ПодготовитьЗначенияЗаполнения(МассивЗаказов, ТекстОшибки);

	Если ЗначенияЗаполнения = Неопределено Тогда
		ПоказатьПредупреждение(Неопределено, ТекстОшибки);
		Возврат;
	КонецЕсли;

	ПараметрыОткрытия = Новый Структура("ЗначенияЗаполнения", ЗначенияЗаполнения);
	ОткрытьФорму("Документ.ПеремещениеЗапасов.ФормаОбъекта", ПараметрыОткрытия, ПараметрыВыполненияКоманды.Источник);

КонецПроцедуры
