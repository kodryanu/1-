#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныеПроцедурыИФункции

// Перед формированием счета на оплату по заказу покупателя строки одного товара,
// различающиеся только партией (пары-партии и строка резерва), сворачиваются в одну
// строку с суммарным количеством и суммами. Партия в счет не выводится, поэтому
// различать такие строки в печатной форме не нужно.
//
// Сигнатура должна совпадать с процедурой СформироватьПФ модуля менеджера
// обработки ПечатьСчетНаОплату - обработчик создается в конфигураторе командой
// "Добавить в расширение" -> "Установить обработчик: Перед".
//
&Перед("СформироватьПФ")
Процедура ПП_СформироватьПФ(ПечатнаяФорма, ДанныеОбъектовПечати, ОбъектыПечати, ЧастичнаяОплата, ВыводитьФаксимиле)
	
	Если ТипЗнч(ДанныеОбъектовПечати) <> Тип("ТаблицаЗначений")
		Или ДанныеОбъектовПечати.Колонки.Найти("ТаблицаЗапасы") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТипЗаказПокупателя = Тип("ДокументСсылка.ЗаказПокупателя");
	
	Для Каждого ДанныеДокумента Из ДанныеОбъектовПечати Цикл
		
		Если ТипЗнч(ДанныеДокумента.Ссылка) <> ТипЗаказПокупателя
			Или ТипЗнч(ДанныеДокумента.ТаблицаЗапасы) <> Тип("ТаблицаЗначений") Тогда
			Продолжить;
		КонецЕсли;
		
		ДанныеДокумента.ТаблицаЗапасы = ПП_СвернутьСтрокиТоваровСРазнымиПартиями(ДанныеДокумента.ТаблицаЗапасы);
		
	КонецЦикла;
	
КонецПроцедуры

// Сворачивает строки товаров, отличающиеся только партией (и служебными полями строки).
// Порядок строк сохраняется: свернутая строка стоит на месте первой строки товара.
// Один проход по таблице, поиск ранее встреченного товара - по индексированной таблице ключей.
//
// Параметры:
//  ТаблицаЗапасы - ТаблицаЗначений - колонка ТаблицаЗапасы данных печати.
//
// Возвращаемое значение:
//  ТаблицаЗначений - таблица той же структуры со свернутыми строками.
//
Функция ПП_СвернутьСтрокиТоваровСРазнымиПартиями(ТаблицаЗапасы)
	
	Если ТаблицаЗапасы.Количество() < 2 Тогда
		Возврат ТаблицаЗапасы;
	КонецЕсли;
	
	Колонки = ТаблицаЗапасы.Колонки;
	
	// Строка печатной формы определяется этими полями; партия, спецификация,
	// ключ связи и номер строки в ключ не входят.
	ПоляКлюча = ПП_СуществующиеКолонки(Колонки,
		"Код, ПредставлениеНоменклатуры, Артикул, Характеристика, ЕдиницаИзмерения, Содержание,
		|Цена, ПроцентСкидкиНаценки, СтавкаНДС, НомерВариантаКП, НоменклатураНабора, ХарактеристикаНабора");
	
	ПоляСумм = ПП_СуществующиеКолонки(Колонки,
		"Количество, Сумма, СуммаНДС, Всего, Вес, СуммаСкидкиНаценки, СуммаАвтоматическойСкидки, СуммаБезСкидки");
	
	Если ПоляКлюча.Количество() = 0 Или ПоляСумм.Количество() = 0 Тогда
		Возврат ТаблицаЗапасы;
	КонецЕсли;
	
	ИменаПолейКлюча = СтрСоединить(ПоляКлюча, ",");
	
	Ключи = Новый ТаблицаЗначений;
	Для Каждого ИмяПоля Из ПоляКлюча Цикл
		Ключи.Колонки.Добавить(ИмяПоля);
	КонецЦикла;
	Ключи.Колонки.Добавить("СтрокаРезультата");
	Ключи.Индексы.Добавить(ИменаПолейКлюча);
	
	// Разделители вариантов КП и строки наборов выводятся по своим правилам - их не сворачиваем.
	ПризнакиИсключения = ПП_СуществующиеКолонки(Колонки, "ЭтоРазделитель, ЭтоНабор, НеобходимоВыделитьКакСоставНабора");
	
	ЕстьНомерСтроки = (Колонки.Найти("НомерСтроки") <> Неопределено);
	ЕстьСкидка = (Колонки.Найти("ЕстьСкидка") <> Неопределено);
	
	Результат = ТаблицаЗапасы.СкопироватьКолонки();
	Отбор = Новый Структура(ИменаПолейКлюча);
	БылиСвернуты = Ложь;
	
	Для Каждого СтрокаЗапасов Из ТаблицаЗапасы Цикл
		
		УчаствуетВСвертке = Не ПП_ЕстьПризнак(СтрокаЗапасов, ПризнакиИсключения);
		
		Если УчаствуетВСвертке Тогда
			
			ЗаполнитьЗначенияСвойств(Отбор, СтрокаЗапасов);
			НайденныеКлючи = Ключи.НайтиСтроки(Отбор);
			
			Если НайденныеКлючи.Количество() > 0 Тогда
				
				СтрокаРезультата = НайденныеКлючи[0].СтрокаРезультата;
				Для Каждого ИмяПоля Из ПоляСумм Цикл
					СтрокаРезультата[ИмяПоля] = СтрокаРезультата[ИмяПоля] + СтрокаЗапасов[ИмяПоля];
				КонецЦикла;
				Если ЕстьСкидка Тогда
					СтрокаРезультата.ЕстьСкидка = Макс(СтрокаРезультата.ЕстьСкидка, СтрокаЗапасов.ЕстьСкидка);
				КонецЕсли;
				
				БылиСвернуты = Истина;
				Продолжить;
				
			КонецЕсли;
			
		КонецЕсли;
		
		СтрокаРезультата = Результат.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаРезультата, СтрокаЗапасов);
		Если ЕстьНомерСтроки Тогда
			СтрокаРезультата.НомерСтроки = Результат.Количество();
		КонецЕсли;
		
		Если УчаствуетВСвертке Тогда
			НовыйКлюч = Ключи.Добавить();
			ЗаполнитьЗначенияСвойств(НовыйКлюч, СтрокаЗапасов);
			НовыйКлюч.СтрокаРезультата = СтрокаРезультата;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ?(БылиСвернуты, Результат, ТаблицаЗапасы);
	
КонецФункции

Функция ПП_ЕстьПризнак(СтрокаЗапасов, ИменаПризнаков)
	
	Для Каждого ИмяПризнака Из ИменаПризнаков Цикл
		Если СтрокаЗапасов[ИмяПризнака] = Истина Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ПП_СуществующиеКолонки(Колонки, ИменаКолонок)
	
	Результат = Новый Массив;
	Для Каждого ИмяКолонки Из СтрРазделить(ИменаКолонок, ",", Ложь) Цикл
		ИмяКолонки = СокрЛП(ИмяКолонки);
		Если Колонки.Найти(ИмяКолонки) <> Неопределено Тогда
			Результат.Добавить(ИмяКолонки);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#КонецЕсли
