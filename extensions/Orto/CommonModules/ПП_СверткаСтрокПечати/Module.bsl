// Свертка строк товаров заказа покупателя в печатных формах.
//
// Строки одного товара, различающиеся только партией (строка резерва и пары-партии),
// сворачиваются в одну строку с суммарным количеством и суммами. Партия, спецификация,
// ключ связи и номер строки в ключ свертки не входят.
//
// Свойства общего модуля: Сервер = Истина, остальные флажки сняты.

#Область ПрограммныйИнтерфейс

// Сворачивает таблицу товаров в данных печати только для заказов покупателей.
// Данные других документов не изменяются.
//
// Параметры:
//  ДанныеДокументов - ТаблицаЗначений - данные печати с колонками Ссылка и ИмяТабличнойЧасти;
//  ИмяТабличнойЧасти - Строка - колонка с вложенной таблицей товаров;
//  ПеренумероватьСтроки - Булево - присвоить строкам номера 1, 2, 3...
//    По умолчанию номера строк сохраняются: по ним типовой код связывает строки
//    печати с табличной частью документа (например, штрихкоды в форме "Заказ покупателя").
//
Процедура СвернутьТоварыЗаказовПокупателей(ДанныеДокументов, ИмяТабличнойЧасти = "ТаблицаЗапасы",
	ПеренумероватьСтроки = Ложь) Экспорт
	
	Если ТипЗнч(ДанныеДокументов) <> Тип("ТаблицаЗначений")
		Или ДанныеДокументов.Колонки.Найти("Ссылка") = Неопределено
		Или ДанныеДокументов.Колонки.Найти(ИмяТабличнойЧасти) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТипЗаказПокупателя = Тип("ДокументСсылка.ЗаказПокупателя");
	
	Для Каждого ДанныеДокумента Из ДанныеДокументов Цикл
		Если ТипЗнч(ДанныеДокумента.Ссылка) = ТипЗаказПокупателя Тогда
			ДанныеДокумента[ИмяТабличнойЧасти] = СвернутьСтрокиТоваров(ДанныеДокумента[ИмяТабличнойЧасти],
				ПеренумероватьСтроки);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Сворачивает строки таблицы товаров одного документа.
// Порядок строк сохраняется: свернутая строка стоит на месте первой строки товара.
// Один проход по таблице, поиск ранее встреченного товара - по индексированной таблице ключей.
//
// Параметры:
//  ТаблицаЗапасы - ТаблицаЗначений - таблица товаров печатной формы;
//  ПеренумероватьСтроки - Булево - присвоить строкам номера 1, 2, 3...
//
// Возвращаемое значение:
//  ТаблицаЗначений - таблица той же структуры (или исходная, если сворачивать нечего).
//
Функция СвернутьСтрокиТоваров(ТаблицаЗапасы, ПеренумероватьСтроки = Ложь) Экспорт
	
	Если ТипЗнч(ТаблицаЗапасы) <> Тип("ТаблицаЗначений") Тогда
		Возврат ТаблицаЗапасы;
	КонецЕсли;
	
	Колонки = ТаблицаЗапасы.Колонки;
	ЕстьНомерСтроки = (Колонки.Найти("НомерСтроки") <> Неопределено);
	
	ПоляКлюча = СуществующиеКолонки(Колонки, ИменаПолейКлюча());
	ПоляСумм = СуществующиеКолонки(Колонки, ИменаПолейСумм());
	
	Если ТаблицаЗапасы.Количество() < 2 Или ПоляКлюча.Количество() = 0 Или ПоляСумм.Количество() = 0 Тогда
		Если ПеренумероватьСтроки И ЕстьНомерСтроки Тогда
			Перенумеровать(ТаблицаЗапасы);
		КонецЕсли;
		Возврат ТаблицаЗапасы;
	КонецЕсли;
	
	ИменаПолейКлюча = СтрСоединить(ПоляКлюча, ",");
	
	Ключи = Новый ТаблицаЗначений;
	Для Каждого ИмяПоля Из ПоляКлюча Цикл
		Ключи.Колонки.Добавить(ИмяПоля);
	КонецЦикла;
	Ключи.Колонки.Добавить("СтрокаРезультата");
	Ключи.Индексы.Добавить(ИменаПолейКлюча);
	
	// Разделители вариантов КП, строки наборов и прослеживаемые товары
	// выводятся по своим правилам - их не сворачиваем.
	ПризнакиИсключения = СуществующиеКолонки(Колонки, ИменаПризнаковИсключения());
	
	ЕстьСкидка = (Колонки.Найти("ЕстьСкидка") <> Неопределено);
	
	Результат = ТаблицаЗапасы.СкопироватьКолонки();
	Отбор = Новый Структура(ИменаПолейКлюча);
	БылиСвернуты = Ложь;
	
	Для Каждого СтрокаЗапасов Из ТаблицаЗапасы Цикл
		
		УчаствуетВСвертке = Не ЕстьПризнак(СтрокаЗапасов, ПризнакиИсключения);
		
		Если УчаствуетВСвертке Тогда
			
			ЗаполнитьЗначенияСвойств(Отбор, СтрокаЗапасов);
			НайденныеКлючи = Ключи.НайтиСтроки(Отбор);
			
			Если НайденныеКлючи.Количество() > 0 Тогда
				
				СтрокаРезультата = НайденныеКлючи[0].СтрокаРезультата;
				Для Каждого ИмяПоля Из ПоляСумм Цикл
					СтрокаРезультата[ИмяПоля] = СтрокаРезультата[ИмяПоля] + СтрокаЗапасов[ИмяПоля];
				КонецЦикла;
				Если ЕстьСкидка Тогда
					СтрокаРезультата.ЕстьСкидка = Макс(СтрокаРезультата.ЕстьСкидка, СтрокаЗапасов.ЕстьСкидка);
				КонецЕсли;
				
				БылиСвернуты = Истина;
				Продолжить;
				
			КонецЕсли;
			
		КонецЕсли;
		
		СтрокаРезультата = Результат.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаРезультата, СтрокаЗапасов);
		
		Если УчаствуетВСвертке Тогда
			НовыйКлюч = Ключи.Добавить();
			ЗаполнитьЗначенияСвойств(НовыйКлюч, СтрокаЗапасов);
			НовыйКлюч.СтрокаРезультата = СтрокаРезультата;
		КонецЕсли;
		
	КонецЦикла;
	
	Если Не БылиСвернуты Тогда
		Результат = ТаблицаЗапасы;
	КонецЕсли;
	
	Если ПеренумероватьСтроки И ЕстьНомерСтроки Тогда
		Перенумеровать(Результат);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Поля, определяющие строку печатной формы. Отсутствующие в конкретной форме колонки пропускаются.
//
Функция ИменаПолейКлюча()
	
	Возврат "Номенклатура, Код, ПредставлениеНоменклатуры, Артикул, Характеристика, ЕдиницаИзмерения, 
		|Содержание, Цена, ПроцентСкидкиНаценки, СтавкаНДС, НомерВариантаКП, НоменклатураНабора, 
		|ХарактеристикаНабора, КодТНВЭД, ПредставлениеГТД, СтранаКод, ВидУпаковки, КоэффициентЕдиницыИзмерения, 
		|СтруктурнаяЕдиницаРезерв";
	
КонецФункции

// Поля, которые складываются при свертке. Отсутствующие в конкретной форме колонки пропускаются.
//
Функция ИменаПолейСумм()
	
	Возврат "Количество, Сумма, СуммаНДС, Всего, Вес, Объем, СуммаСкидкиНаценки, СуммаАвтоматическойСкидки, 
		|СуммаБезСкидки, Скидка, Резерв, СтоимостьБезНалога, СуммаСкидкиПоСтроке, МассаБрутто, КоличествоМест";
	
КонецФункции

Функция ИменаПризнаковИсключения()
	
	Возврат "ЭтоРазделитель, ЭтоНабор, НеобходимоВыделитьКакСоставНабора, ПрослеживаемыйТовар";
	
КонецФункции

Функция ЕстьПризнак(СтрокаЗапасов, ИменаПризнаков)
	
	Для Каждого ИмяПризнака Из ИменаПризнаков Цикл
		Если СтрокаЗапасов[ИмяПризнака] = Истина Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция СуществующиеКолонки(Колонки, ИменаКолонок)
	
	Результат = Новый Массив;
	Для Каждого ИмяКолонки Из СтрРазделить(ИменаКолонок, ",", Ложь) Цикл
		ИмяКолонки = СокрЛП(ИмяКолонки);
		Если Колонки.Найти(ИмяКолонки) <> Неопределено Тогда
			Результат.Добавить(ИмяКолонки);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура Перенумеровать(ТаблицаЗапасов)
	
	НомерСтроки = 0;
	Для Каждого СтрокаЗапасов Из ТаблицаЗапасов Цикл
		НомерСтроки = НомерСтроки + 1;
		СтрокаЗапасов.НомерСтроки = НомерСтроки;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
