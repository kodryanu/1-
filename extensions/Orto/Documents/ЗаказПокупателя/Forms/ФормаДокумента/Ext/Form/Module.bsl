&НаКлиенте
Процедура ПП_ПечатьСопроводительныхПосле(Команда)
	
	
	МассивСтрок = Элементы.Запасы.ВыделенныеСтроки;
	Если МассивСтрок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТекДанные = Элементы.Запасы.ТекущиеДанные;
	
	
	ОбъектыНазначения = Новый Массив;
	
	Для Каждого СтрокаМассива Из МассивСтрок ЦИкл
		ТекСтрока = Объект.Запасы.НайтиПоИдентификатору(СтрокаМассива);
		
		Если ЗначениеЗаполнено(ТекСтрока.ПП_ЗаказНаПроизводство) Тогда
			ОбъектыНазначения.Добавить(ТекСтрока.ПП_ЗаказНаПроизводство);
		КонецЕсли;	
	КонецЦикла;

	Если ОбъектыНазначения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	
	
	ВПФНаименование	= "Сопроводительный";
	ИдентификаторКомандыПечати = ВПФНаименование;
	ВПФ = ПП_НайтиВПФ(ВПФНаименование);
	
	Если ВПФ.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыОткрытия = Новый Структура("ИсточникДанных, ПараметрыИсточника");
	ПараметрыОткрытия.ИсточникДанных = ВПФ;
	ПараметрыОткрытия.ПараметрыИсточника = Новый Структура("ИдентификаторКоманды, ОбъектыНазначения");
	ПараметрыОткрытия.ПараметрыИсточника.ИдентификаторКоманды = ИдентификаторКомандыПечати;
	ПараметрыОткрытия.ПараметрыИсточника.ОбъектыНазначения = ОбъектыНазначения;
	ОткрытьФорму("ОбщаяФорма" + ".ПечатьДокументов", ПараметрыОткрытия);	
	
	
	Элементы.Запасы.ТекущаяСтрока = ТекДанные;
	
	
КонецПроцедуры

