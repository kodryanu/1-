
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПП_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	ПП_ОбновитьИтогиСервер();
	ПП_ОбновитьСостоянияПослеНаСервере();
	
	МассивЗапасы = Новый Массив;
	
	МассивЗапасы.Добавить("ЗапасыНомерСтроки");
	МассивЗапасы.Добавить("ЗапасыПП_СостояниеЗаказа");
	МассивЗапасы.Добавить("ЗапасыПП_ЗаказНаПроизводствоКратко");
	МассивЗапасы.Добавить("ЗапасыНоменклатура");
	МассивЗапасы.Добавить("ЗапасыХарактеристика");
	МассивЗапасы.Добавить("ЗапасыПартия");
	МассивЗапасы.Добавить("ЗапасыКоличество");
	МассивЗапасы.Добавить("ЗапасыЕдиницаИзмерения");
	МассивЗапасы.Добавить("ЗапасыЦена");
	МассивЗапасы.Добавить("ЗапасыСумма");
	МассивЗапасы.Добавить("ЗапасыСпецификация");
	
	
	ПП_УстановитьУсловноеОформление(
				МассивЗапасы,
				"Объект.Запасы.ПП_СостояниеЗаказа",
					ПредопределенноеЗначение("Справочник.СостоянияЗаказовНаПроизводство.Завершен"),
						ВидСравненияКомпоновкиДанных.НеРавно,
				"ЦветТекста",
					Новый Цвет(255, 0, 0)
					);
			
	
	
КонецПроцедуры

&НаКлиенте
Процедура ПП_ПриОткрытииПосле(Отказ)
	
	Элементы.СтраницаЗапасы.Заголовок = "Пары-партии";
	
	Префикс = "Пары";
	ПП_ДобавитьПрефиксКЗаголовку(Элементы.СкидкаПроцент, Префикс);	
	ПП_ДобавитьПрефиксКЗаголовку(Элементы.СкидкаСумма, Префикс);	
	ПП_ДобавитьПрефиксКЗаголовку(Элементы.ИтогСуммаНДС, Префикс);	
	ПП_ДобавитьПрефиксКЗаголовку(Элементы.ИтогВсего, Префикс);	
	
	ПП_КонтрольЛевыхЗНП();
	
КонецПроцедуры

&НаСервере
Процедура ПП_ПослеЗаписиНаСервереПосле(ТекущийОбъект, ПараметрыЗаписи)
	
	ПП_ОбновитьЗапасы()
	
КонецПроцедуры

&НаСервере
Процедура ПП_ПриЧтенииНаСервереПосле(ТекущийОбъект)
	
	ПП_ОбновитьЗапасы()	

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТаблицыФормыЗапасы

&НаКлиенте
Процедура ПП_ЗапасыВыборПеред(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если Элемент.ТекущийЭлемент.Имя = "ЗапасыПП_ЗаказНаПроизводствоКратко" Тогда
        СтандартнаяОбработка = Ложь;
        ПоказатьЗначение(,Элемент.ТекущиеДанные.ПП_ЗаказНаПроизводство);
    КонецЕсли;
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийЭлементовТаблицыФормыЗапасы

&НаКлиенте
Процедура ПП_ЗапасыНоменклатураПриИзмененииПосле(Элемент)
		
	СтрокаТабличнойЧасти = Элементы.ПП_Запасы.ТекущиеДанные;
	
	Если СтрокаТабличнойЧасти.ЭтоРазделитель Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураДанные = Новый Структура;
	СтруктураДанные.Вставить("Организация", Объект.Организация);
	СтруктураДанные.Вставить("Номенклатура", СтрокаТабличнойЧасти.Номенклатура);
	СтруктураДанные.Вставить("Характеристика", СтрокаТабличнойЧасти.Характеристика);
	СтруктураДанные.Вставить("НалогообложениеНДС", Объект.НалогообложениеНДС);
	
	//Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийЗаказПокупателя.ЗаказНаПродажу")
	//	Тогда
	//	СтатусПартии = Новый СписокЗначений;
	//	СтатусПартии.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыПартий.СобственныеЗапасы"));
	//	СтатусПартии.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыПартий.ТоварыНаКомиссии"));
	//	
	//	СтруктураДанные.Вставить("СтатусПартии", СтатусПартии);
	//КонецЕсли;
		
	Если ЗначениеЗаполнено(Объект.ВидЦен) Тогда
		
		СтруктураДанные.Вставить("ДатаОбработки", Объект.Дата);
		СтруктураДанные.Вставить("ВалютаДокумента", Объект.ВалютаДокумента);
		СтруктураДанные.Вставить("СуммаВключаетНДС", Объект.СуммаВключаетНДС);
		СтруктураДанные.Вставить("ВидЦен", Объект.ВидЦен);
		СтруктураДанные.Вставить("Коэффициент", 1);
		СтруктураДанные.Вставить("ВидСкидкиНаценки", Объект.ВидСкидкиНаценки);
		
	КонецЕсли;
	
	// ДисконтныеКарты
	СтруктураДанные.Вставить("ДисконтнаяКарта", Объект.ДисконтнаяКарта);
	СтруктураДанные.Вставить("ПроцентСкидкиПоДисконтнойКарте", Объект.ПроцентСкидкиПоДисконтнойКарте);
	// Конец ДисконтныеКарты
	
	СтруктураДанные = ПолучитьДанныеНоменклатураПриИзменении(СтруктураДанные);
	
	Если СтруктураДанные.ЭтоНабор И НЕ СтруктураДанные.ИспользоватьХарактеристики Тогда
		
		// Наборы
		ЗаменитьСтрокуЗапасовДаннымиНабора(ЭтотОбъект, СтрокаТабличнойЧасти, СтруктураДанные);
		
		ЗаполнитьПризнакиИспользованияХарактеристик();
		
		// АвтоматическиеСкидки.
		СброситьФлагСкидкиРассчитаныКлиент("РассчитатьСуммуВСтрокеТабличнойЧасти", "Сумма");
		// Конец АвтоматическиеСкидки
	
		#Если ВебКлиент ИЛИ МобильныйКлиент Тогда
		Элементы.Запасы.ЗакончитьРедактированиеСтроки(Истина);
		#КонецЕсли 
		
	Иначе
		
		Если ТипЗнч(СтрокаТабличнойЧасти.Номенклатура) = Тип("СправочникСсылка.Номенклатура") Тогда
			СтрокаТабличнойЧасти.НоменклатураСсылка = СтрокаТабличнойЧасти.Номенклатура;
		КонецЕсли;
		СтрокаТабличнойЧасти.ЕдиницаИзмерения = СтруктураДанные.ЕдиницаИзмерения;
		СтрокаТабличнойЧасти.Количество = 1;
		СтрокаТабличнойЧасти.Цена = СтруктураДанные.Цена;
		СтрокаТабличнойЧасти.ПроцентСкидкиНаценки = СтруктураДанные.ПроцентСкидкиНаценки;
		СтрокаТабличнойЧасти.СтавкаНДС = СтруктураДанные.СтавкаНДС;
		СтрокаТабличнойЧасти.Содержание = "";
		СтрокаТабличнойЧасти.Спецификация = СтруктураДанные.Спецификация;
		
		СтрокаТабличнойЧасти.ТипНоменклатурыЗапас = СтруктураДанные.ЭтоЗапас;
		СтрокаТабличнойЧасти.ВесЕдиницыТовара = СтруктураДанные.ВесЕдиницыТовара;
		СтрокаТабличнойЧасти.Вес = СтрокаТабличнойЧасти.ВесЕдиницыТовара * СтрокаТабличнойЧасти.Количество;
		СтрокаТабличнойЧасти.ОбъемЕдиницыТовара = СтруктураДанные.ОбъемЕдиницыТовара;
		СтрокаТабличнойЧасти.Объем = СтрокаТабличнойЧасти.ОбъемЕдиницыТовара * СтрокаТабличнойЧасти.Количество;
		
		СтрокаТабличнойЧасти.ИспользоватьХарактеристики = СтруктураДанные.ИспользоватьХарактеристики;
		СтрокаТабличнойЧасти.ПроверятьЗаполнениеХарактеристики = СтруктураДанные.ПроверятьЗаполнениеХарактеристики;
		СтрокаТабличнойЧасти.ЗаполнениеХарактеристикиПроверено = Истина;
		
		Если СтруктураДанные.ИспользоватьХарактеристики
			Тогда
			СтрокаТабличнойЧасти.Характеристика = СтруктураДанные.Характеристика;
			СтрокаТабличнойЧасти.Спецификация =  СтруктураДанные.Спецификация;
		КонецЕсли;
		
		//Партии
		СтрокаТабличнойЧасти.ИспользоватьПартии = СтруктураДанные.ИспользоватьПартии;
		СтрокаТабличнойЧасти.ПроверятьЗаполнениеПартий = СтруктураДанные.ПроверятьЗаполнениеПартий;
		
		Если СтруктураДанные.ИспользоватьПартии
			Тогда
			СтрокаТабличнойЧасти.Партия = СтруктураДанные.Партия;
		КонецЕсли;
		// Конец Партии
		
		// Наборы
		СтрокаТабличнойЧасти.ЭтоНабор = СтруктураДанные.ЭтоНабор;
		
		РассчитатьСуммуВСтрокеТабличнойЧасти("ПП_Запасы");
		
	КонецЕсли; 
	
	ПП_РассчитатьОбъемИВесЗаказа();
	ПП_ОбновитьИтогиКлиент();
	ПП_ОчиститьКалькуляцию();
	ПП_ВключитьИндикаторНеобходимостиПересчетаСтоимостиДоставки();
	
КонецПроцедуры

&НаКлиенте
Процедура ПП_ЗапасыХарактеристикаПриИзмененииПосле(Элемент)
		
	СтрокаТабличнойЧасти = Элементы.ПП_Запасы.ТекущиеДанные;
	
	СтруктураДанные = Новый Структура;
	СтруктураДанные.Вставить("Организация", Компания);
	СтруктураДанные.Вставить("Номенклатура", 	СтрокаТабличнойЧасти.Номенклатура);
	СтруктураДанные.Вставить("Характеристика", 	СтрокаТабличнойЧасти.Характеристика);
	СтруктураДанные.Вставить("НалогообложениеНДС", Объект.НалогообложениеНДС);
	
	Если ЗначениеЗаполнено(Объект.ВидЦен) Тогда
	
		СтруктураДанные.Вставить("ДатаОбработки", 		Объект.Дата);
		СтруктураДанные.Вставить("ВалютаДокумента", 	Объект.ВалютаДокумента);
		СтруктураДанные.Вставить("СуммаВключаетНДС",	Объект.СуммаВключаетНДС);
		
		СтруктураДанные.Вставить("СтавкаНДС", 	СтрокаТабличнойЧасти.СтавкаНДС);
		СтруктураДанные.Вставить("Цена", 		СтрокаТабличнойЧасти.Цена);
		
		СтруктураДанные.Вставить("ВидЦен", Объект.ВидЦен);
		СтруктураДанные.Вставить("ЕдиницаИзмерения", СтрокаТабличнойЧасти.ЕдиницаИзмерения);
		
	КонецЕсли;
	
	СтруктураДанные = ПолучитьДанныеХарактеристикаПриИзменении(СтруктураДанные);
	
	Если СтруктураДанные.ЭтоНабор Тогда
		
		// Наборы
		ЗаменитьСтрокуЗапасовДаннымиНабора(ЭтотОбъект, СтрокаТабличнойЧасти, СтруктураДанные);
		
		ЗаполнитьПризнакиИспользованияХарактеристик();
		
		// АвтоматическиеСкидки.
		СброситьФлагСкидкиРассчитаныКлиент("РассчитатьСуммуВСтрокеТабличнойЧасти", "Сумма");
		// Конец АвтоматическиеСкидки
	
	Иначе
		
		СтрокаТабличнойЧасти.Цена = СтруктураДанные.Цена;
		СтрокаТабличнойЧасти.Содержание = "";
		СтрокаТабличнойЧасти.Спецификация = СтруктураДанные.Спецификация;
		
		РассчитатьСуммуВСтрокеТабличнойЧасти("ПП_Запасы");
		
	КонецЕсли; 
	
	ПП_ОбновитьИтогиКлиент();
	ПП_ОчиститьКалькуляцию();
	ПП_ВключитьИндикаторНеобходимостиПересчетаСтоимостиДоставки();

КонецПроцедуры

&НаКлиенте
Процедура ПП_ЗапасыКоличествоПриИзмененииПосле(Элемент)
	
	СтрокаТабличнойЧасти = Элементы.ПП_Запасы.ТекущиеДанные;
	СтрокаТабличнойЧасти.Вес = СтрокаТабличнойЧасти.ВесЕдиницыТовара * СтрокаТабличнойЧасти.Количество;
	СтрокаТабличнойЧасти.Объем = СтрокаТабличнойЧасти.ОбъемЕдиницыТовара * СтрокаТабличнойЧасти.Количество;
	
	ПП_РассчитатьСуммуВСтрокеТабличнойЧасти();
	
	ПП_РассчитатьОбъемИВесЗаказа();
	ПП_ОбновитьИтогиКлиент();
	ПП_ПересчитатьПлатежныйКалендарь();
	ПП_ОчиститьКалькуляцию();
	ПП_ВключитьИндикаторНеобходимостиПересчетаСтоимостиДоставки();
	
КонецПроцедуры

&НаКлиенте
Процедура ПП_ЗапасыЦенаПриИзмененииПосле(Элемент)
	
	ПП_РассчитатьСуммуВСтрокеТабличнойЧасти();
	
	ПП_ОбновитьИтогиКлиент();
	ПП_ПересчитатьПлатежныйКалендарь();
	ПП_ОчиститьКалькуляцию();
	ПП_ВключитьИндикаторНеобходимостиПересчетаСтоимостиДоставки();
	
КонецПроцедуры

#КонецОбласти

#Область КомандыФормы

&НаКлиенте
Процедура ПП_ЗаполннитьПарыПосле(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПоказатьПредупреждение(,"Необходимо записать документ");
		Возврат;	
	КонецЕсли;
	
	Если объект.ПП_Запасы.Количество() = 0 Тогда
		ПоказатьПредупреждение(,"Для создания пар необходимо ввести Товары");
		Возврат;	
	КонецЕсли;
	
	//Для Каждого строкаПП_Запасы из объект.ПП_Запасы Цикл 
	//	Если Не ЗначениеЗаполнено(строкаПП_Запасы.Спецификация) Тогда
	//		ПоказатьПредупреждение(,"Необходимо заполнить Спецификацию для" + Символы.ПС + 
	//		 						строкаПП_Запасы.Номенклатура );
	//		Возврат;	
	//	КонецЕсли;
	//КонецЦикла;
	
	
	Отмена = Ложь;
	КоличествоОбработанных = ПП_ЗаполнитьПартииНаКлиента(Отмена);
	
	ОбновитьИтогиКлиент();
	
	Если Отмена Тогда
		Возврат;	
	КонецЕсли;
	
	Если Не КоличествоОбработанных = 0 Тогда
		Оповещение = Новый ОписаниеОповещения("ОповещениеОКоличествеТоваров", ЭтотОбъект);
		ПоказатьПредупреждение(Оповещение,"Обработано Товаров: " + КоличествоОбработанных);
	КонецЕсли;
	
	ПП_ОбновитьСостоянияПослеНаСервере();	
	
	ЭтотОбъект.Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ОповещениеОКоличествеТоваров(Результат) Экспорт
	
	ыы =	Объект.Запасы.Количество();

	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаЗапасы;

	
КонецПроцедуры
 

&НаКлиенте
Процедура ПП_СоздатьЗаказНаПроизводствоПосле(Команда)
	
	
	МассивСтрок = Элементы.Запасы.ВыделенныеСтроки;
	Если МассивСтрок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТекДанные = Элементы.Запасы.ТекущиеДанные;
	
	Для Каждого СтрокаМассива Из МассивСтрок ЦИкл
		ТекСтрока = Объект.Запасы.НайтиПоИдентификатору(СтрокаМассива);
		
		Если Не ЗначениеЗаполнено(ТекСтрока.ПП_ЗаказНаПроизводство) Тогда
			// Надо создавать ЗНП
			Если ЭтотОбъект.Модифицированность Тогда
				ПоказатьПредупреждение(,"Для создания Заказа на производство необходимо записать документ");
				Возврат;	
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;

	
	Для Каждого СтрокаМассива Из МассивСтрок ЦИкл
		ТекСтрока = Объект.Запасы.НайтиПоИдентификатору(СтрокаМассива);

		Если Не ЗначениеЗаполнено(ТекСтрока.ПП_ЗаказНаПроизводство) Тогда
			//Создаеи ЗНП
			НомерСтрокиЗапасов = ТекСтрока.НомерСтроки;
			Отмена = Ложь;
			СообщениеОтмены = "";
			ЗаказНаПроизводство = ПП_СоздатьЗаказНаПроизводствоПослеНаСервере(Объект.Ссылка, НомерСтрокиЗапасов, Отмена, СообщениеОтмены);
			Если Отмена Тогда
				Если ЗначениеЗаполнено(СообщениеОтмены) Тогда 
					ПоказатьПредупреждение(,СообщениеОтмены);
				КонецЕсли;
				Возврат;
			КонецЕсли; 
			
			ТекСтрока.ПП_ЗаказНаПроизводство = ЗаказНаПроизводство;
			ТекСтрока.ПП_ЗаказНаПроизводствоКратко = ПП_ЗаказНаПроизводствоКратко(ЗаказНаПроизводство);
			ТекСтрока.ПП_СостояниеЗаказа = ПП_СостояниеЗаказаНаСервере(ЗаказНаПроизводство);
		КонецЕсли;
		//Открывем ЗНП
		ПоказатьЗначение(,ТекСтрока.ПП_ЗаказНаПроизводство);
	КонецЦикла;	
	
	Элементы.Запасы.ТекущаяСтрока = ТекДанные;
	
	
КонецПроцедуры


&НаСервере
Функция ПП_СостояниеЗаказаНаСервере(ЗаказНаПроисзовдство)
	Возврат ЗаказНаПроисзовдство.СостояниеЗаказа;
КонецФункции

&НаСервере
Функция ПП_СоздатьЗаказНаПроизводствоПослеНаСервере(ДокументСсылка, НомерСтрокиЗапасов, Отмена, СообщениеОтмены)
	
	СтратегияЗаполнения = Новый Соответствие;
	СтратегияЗаполнения[Тип("Структура")] = "ЗаполнитьПоСтруктуре";
	СтратегияЗаполнения[Тип("ДокументСсылка.ЗаказПокупателя")] = "ЗаполнитьПоЗаказуПокупателя";
	СтратегияЗаполнения[Тип("ДокументСсылка.ЗаказНаПроизводство")] = "ЗаполнитьПоЗаказуНаПроизводство";
	
	//Если ПолучитьФункциональнуюОпцию("РезервированиеЗапасов") Тогда
	//	ИсключаяСвойства = "";
	//Иначе
	//	ИсключаяСвойства = "ЗаказПокупателя, ЗаказНаПроизводствоОснование";
	//КонецЕсли;
	
	ИсключаяСвойства = "";
	ИсключаяСвойства = ИсключаяСвойства + ?(ПустаяСтрока(ИсключаяСвойства), "", ",") + "СостояниеЗаказа,ВариантЗавершения";
	
	ЗаказНаПроизводство = Документы.ЗаказНаПроизводство.СоздатьДокумент();
	ЗаказНаПроизводство.ПоложениеИсполнителя = ПредопределенноеЗначение("Перечисление.ПоложениеРеквизитаНаФорме.ВТабличнойЧасти");
	ЗаказНаПроизводство.Дата = ТекущаяДата();
	
	СостояниеЗаказаВработе = Справочники.СостоянияЗаказовНаПроизводство.НайтиПоНаименованию("В работе", Истина);
	ЗаказНаПроизводство.СостояниеЗаказа = СостояниеЗаказаВработе;
	ЗаказНаПроизводство.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийЗаказНаПроизводство.Сборка");
	
	
	//ДанныеЗаполнения = ПП_ПолучитьСтруктуруИзДокумента(ДокументСсылка);
	//ЗаполнениеОбъектовУНФ.ЗаполнитьДокумент(ЗаказНаПроизводство, ДанныеЗаполнения, СтратегияЗаполнения, ИсключаяСвойства);
	ЗаполнитьДокумент(ЗаказНаПроизводство, ДокументСсылка, СтратегияЗаполнения, ИсключаяСвойства, НомерСтрокиЗапасов);
	
	//ДозаполнитьПоУмолчанию();
	//
	//Если ПолучитьФункциональнуюОпцию("РезервированиеЗапасов") Тогда
	//	ДокументОснование = Неопределено;
	//КонецЕсли;
	
	Если ЗаказНаПроизводство.Продукция.Количество() =  0 Тогда
		Отмена = Истина;
		СообщениеОтмены = "Не создана Продукция в Заказе на производство" + символы.ПС + 
							"Возможно уже созданы Заказы на производство на все количество по данной номенклатуре ";
		Возврат Неопределено;
	КонецЕсли;
		
	
	ПП_ЗаписатьОбъект(ЗаказНаПроизводство, Отмена);
	
	Если Отмена Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ЗаказНаПроизводство.Ссылка;
	
КонецФункции

