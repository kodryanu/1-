&НаСервере
Функция ПП_ПолучитьСтруктуруИзДокумента(СсылкаНаДокумент)
    Структура = Новый Структура(); /// реквизиты     
    Для каждого Реквизит из СсылкаНаДокумент.Метаданные().Реквизиты Цикл
        Структура.Вставить(Реквизит.Имя, СсылкаНаДокумент[Реквизит.Имя]);
    КонецЦикла; /// таблицы     
    Для каждого ТабличнаяЧасть из СсылкаНаДокумент.Метаданные().ТабличныеЧасти Цикл
        Структура.Вставить(ТабличнаяЧасть.Имя, СсылкаНаДокумент[ТабличнаяЧасть.Имя].Выгрузить());
    КонецЦикла;
    
    Возврат Структура;
КонецФункции

Процедура ПП_ЗаписатьОбъект(Объект, Отмена)
	
	Попытка
		Объект.Записать();
	Исключение
		ТекстСообщения = НСтр("ru = 'При записи объекта " + Объект.Представление +" произошла ошибка!
		|Дополнительное описание: %ДополнительноеОписание%'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ДополнительноеОписание%", ОписаниеОшибки());
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Отмена = Истина;
		Возврат;
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#Область РаботаСПартиями


&НаСервере
//&НаКлиенте
Функция ПП_ЗаполнитьПартииНаКлиента(Отмена)
	
	СсылкаБезНДС = СсылкаБезНДСНаСервере();
	
	КоличестоОбработанныхТоваров = 0;
	
	Объект.Запасы.Очистить();
	
	Для Каждого строкаПП_Запасы Из Объект.ПП_Запасы Цикл
		Если Не ЗначениеЗаполнено(строкаПП_Запасы.Спецификация) Тогда
			Продолжить;	
		КонецЕсли;
		
		Если строкаПП_Запасы.Количество = 0 Тогда
			Продолжить;	
		КонецЕсли;
		
		
		КоличествоПар = строкаПП_Запасы.Количество;
		Для НомерПары = 1 По КоличествоПар Цикл
			Партия = ПП_ПолучитьПартию(строкаПП_Запасы.Номенклатура, строкаПП_Запасы.Характеристика, НомерПары, КоличествоПар, Объект.Ссылка, Отмена);
			Если Отмена Тогда
				Возврат 0;
			КонецЕсли;
			
			СтрокаЗапасы = Объект.Запасы.Добавить();
			СтрокаЗапасы.Номенклатура = строкаПП_Запасы.Номенклатура;
			СтрокаЗапасы.ТипНоменклатурыЗапас = Истина;
			СтрокаЗапасы.ЕдиницаИзмерения = строкаПП_Запасы.ЕдиницаИзмерения;
			
			СтрокаЗапасы.ИспользоватьХарактеристики = Истина;
			СтрокаЗапасы.Характеристика = строкаПП_Запасы.Характеристика;
			
			СтрокаЗапасы.Спецификация = строкаПП_Запасы.Спецификация;
			
			СтрокаЗапасы.СтавкаНДС = СсылкаБезНДС;

			СтрокаЗапасы.ИспользоватьПартии = Истина;
			СтрокаЗапасы.ПроверятьЗаполнениеПартий = Истина;
			СтрокаЗапасы.Партия = Партия;
			СтрокаЗапасы.Количество = 1;
			СтрокаЗапасы.Цена = строкаПП_Запасы.Цена;
			СтрокаЗапасы.Сумма = строкаПП_Запасы.Цена;
			СтрокаЗапасы.Всего = строкаПП_Запасы.Цена;
			
			//ТС+++
			
			СтрокаЗапасы.СтруктурнаяЕдиницаРезерв = Объект.СтруктурнаяЕдиницаРезерв;
			
			//ТС---
			
			КоличестоОбработанныхТоваров = 	КоличестоОбработанныхТоваров + 1;
		КонецЦикла;		
	КонецЦикла;
		
	Возврат КоличестоОбработанныхТоваров;
	
КонецФункции

