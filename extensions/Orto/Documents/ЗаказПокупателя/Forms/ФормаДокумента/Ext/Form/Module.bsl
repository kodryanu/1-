// Разбивает строки вкладки "Пары-партии" с пустой партией: в строке остается количество
// "В резерве", на незарезервированное количество создаются строки по 1 шт. с партиями-парами.
//
&НаКлиенте
Процедура ПП_СоздатьПарыПартии(Команда)
	
	Если ТолькоПросмотр Тогда
		Возврат;
	КонецЕсли;
	
	// Партии-пары ссылаются на заказ, поэтому заказ должен быть записан.
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Для создания пар-партий необходимо записать документ.'"));
		Возврат;
	КонецЕсли;
	
	// Завершаем редактирование текущей строки, иначе значения из буфера редактирования
	// (Количество, Резерв) перекроют результат сервера в отображении таблицы.
	Элементы.Запасы.ЗакончитьРедактированиеСтроки(Ложь);
	
	// Один серверный вызов на всю операцию.
	Результат = ПП_СоздатьПарыПартииНаСервере();
	
	Если Результат.Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.КоличествоПар = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Нет строк для создания пар-партий.
			|Пары-партии создаются для строк с пустой партией, в которых количество больше, чем ""В резерве"".'"));
		Возврат;
	КонецЕсли;
	
	// Суммы распределены без изменения итогов строки, поэтому достаточно обновить итоги формы.
	ПП_ОбновитьИтогиКлиент();
	ОчиститьКалькуляцию();
	
	Модифицированность = Истина;
	
	// Табличная часть заменена на сервере целиком - перерисовываем форму.
	ОбновитьОтображениеДанных();
	
	ПоказатьОповещениеПользователя(НСтр("ru = 'Пары-партии созданы'"), , 
		СтрШаблон(НСтр("ru = 'Обработано строк: %1, строк с парами-партиями: %2'"),
			Результат.КоличествоСтрок, Результат.КоличествоПар));
	
КонецПроцедуры

