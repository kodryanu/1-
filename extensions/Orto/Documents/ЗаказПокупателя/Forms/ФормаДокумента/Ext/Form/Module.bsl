	// Конец Ручная скидка

	ОбновитьИтоги(
		Объект.Запасы,
		ИтогВсего,
		ИтогСуммаНДС,
		ДанныеДляРасчетаИтогов);
	
	ПП_ОбновитьИтоги(
		Объект.ПП_Запасы,
		ПП_ИтогВсего,
		ПП_ИтогСуммаНДС);
	
