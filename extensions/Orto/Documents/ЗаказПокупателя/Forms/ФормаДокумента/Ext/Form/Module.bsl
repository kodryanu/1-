Процедура ПП_ОбновитьИтоги(
			ТаблицаПП_Запасы,
			ПП_ИтогВсего,
			ПП_ИтогСуммаНДС)
	
	ПП_ИтогВсего = 0;
	ПП_ИтогСуммаНДС = 0;
	
